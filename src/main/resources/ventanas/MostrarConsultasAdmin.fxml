                <TableColumn fx:id="nombreAdminColumn" prefWidth="135.0" text="Nombre administrador" />
                <TableColumn fx:id="idAdminColumn" minWidth="3.0" prefWidth="109.0" text="ID administrador" />
                <TableColumn fx:id="fechaModificacionColumn" prefWidth="124.0" text="Fecha modificacion" />
                <TableColumn fx:id="codigoModificacionColumn" prefWidth="169.0" text="Codigo modificacion" />
            </columns>
        </TableView>

        <TableView fx:id="generalTable" layoutX="44.0" layoutY="90.0" prefHeight="200.0" prefWidth="742.0" styleClass="table-view">
            <columns>
                <TableColumn fx:id="nombreGeneralColumn" prefWidth="133.33330917358398" text="Nombre producto" />
                <TableColumn fx:id="codigoGeneralColumn" prefWidth="129.9999542236328" text="Codigo producto" />
                <TableColumn fx:id="proveedorGeneralColumn" prefWidth="139.33340454101562" text="Nombre proveedor" />
                <TableColumn fx:id="cProveedorGeneralColumn" prefWidth="135.33334350585938" text="Codigo proveedor" />
                <TableColumn fx:id="categoriaGeneralColumn" prefWidth="79.33331298828125" text="Categoria" />
