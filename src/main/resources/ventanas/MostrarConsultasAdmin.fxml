            </columns>
        </TableView>

        <Button fx:id="reporteCalcularValorButton" layoutX="73.0" layoutY="303.0" onAction="#calcularValorReporteOnAction" styleClass="button" text="Calcular valor total producto" />
        <Spinner fx:id="valorTotalSpinner" layoutX="369.0" layoutY="309.0" styleClass="spinner" />
      <AnchorPane layoutY="-5.0" prefHeight="85.0" prefWidth="841.0" style="-fx-background-color: #5EB0E8;">
         <children>
      
              <Label fx:id="consultaLbl" layoutX="327.0" layoutY="33.0" styleClass="label" text="Consultas disponibles" />
         </children>
      </AnchorPane>
      <AnchorPane layoutY="373.0" prefHeight="31.0" prefWidth="841.0" style="-fx-background-color: #5EB0E8;" />
