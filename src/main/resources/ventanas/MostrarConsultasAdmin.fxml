                <TableColumn fx:id="codigoPedidoColumn" prefWidth="104.0" text="Codigo pedido" />
                <TableColumn fx:id="codigoAdministradorColumn" prefWidth="133.0" text="Codigo administrador" />
                <TableColumn fx:id="nombreAdministradorColumn" prefWidth="146.0" text="Nombre administrador" />
                <TableColumn fx:id="codigoProveedorColumn" prefWidth="111.0" text="Codigo proveedor" />
                <TableColumn fx:id="nombreProveedorColumn" prefWidth="121.0" text="Nombre proveedor" />
                <TableColumn fx:id="fechaPedidoColumn" prefWidth="126.0" text="Fecha pedido" />
            </columns>
        </TableView>

        <Button fx:id="verificarProductosButton" layoutX="44.0" layoutY="290.0" mnemonicParsing="false" onAction="#verificarProductosOnAction" styleClass="button" text="Verificar productos del pedido" visible="false" />

        <TableView fx:id="modificacionesTable" layoutX="152.0" layoutY="84.0" prefHeight="200.0" prefWidth="538.0" styleClass="table-view" visible="false">
