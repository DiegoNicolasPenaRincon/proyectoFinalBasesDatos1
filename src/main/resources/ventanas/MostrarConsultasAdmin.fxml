<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="841.0" stylesheets="@estilos/mostrarConsultas.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.alquiler.controller.MostrarConsultasAdminController">
    <children>
        <TableView fx:id="pedidosTable" layoutX="36.0" layoutY="62.0" prefHeight="200.0" prefWidth="742.0" styleClass="table-view" visible="false">
