<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="335.0" prefWidth="600.0" stylesheets="@estilos/estilo.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.alquiler.controller.InicioSesionController">

   <children>
      <VBox alignment="CENTER" layoutX="150.0" layoutY="40.0" prefWidth="300.0" spacing="15">
         <Label fx:id="inicioSesionLabel" styleClass="titulo" text="Inicio de sesion" />

         <Label fx:id="documentoLabel" text="Documento de identidad" styleClass="label" />
         <TextField fx:id="documentoEntidadTRextfield" promptText="Ingrese su documento" styleClass="campo" />

         <Label fx:id="contrasenaLabel" text="Contraseña" styleClass="label" />
         <PasswordField fx:id="contrasenaPasswordField" promptText="Ingrese su contraseña" styleClass="campo" />

         <Button fx:id="IngresarButton" onAction="#ingresarOnAction" styleClass="boton" text="Ingresar" />
      </VBox>
   </children>
</AnchorPane>
