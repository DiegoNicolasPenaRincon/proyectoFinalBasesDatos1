<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="501.0" prefWidth="968.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.alquiler.controller.VentanaAdministradorController">
   <children>
      <TableView fx:id="inventarioTable" layoutX="21.0" layoutY="120.0" prefHeight="200.0" prefWidth="529.0">
        <columns>
          <TableColumn fx:id="nombreInventarioColumn" prefWidth="126.0" text="Nombre producto" />
          <TableColumn fx:id="codigoInventarioPColum" prefWidth="136.0" text=" Codigo producto" />
            <TableColumn fx:id="disponiblesColum" prefWidth="72.0" text="Disponibles" />
            <TableColumn fx:id="vendidasColumn" prefWidth="78.0" text="Vendidas" />
            <TableColumn fx:id="numeroReferenciaColumn" prefWidth="115.0" text="Numero Referencia" />
        </columns>
      </TableView>
      <Button fx:id="agregarProductoButton" layoutX="630.0" layoutY="422.0" mnemonicParsing="false" onAction="#agregarProductoOnAction" prefHeight="25.0" prefWidth="207.0" text="Agregar producto" />
      <Label fx:id="nombreAgregarLabel" layoutX="576.0" layoutY="117.0" text="Nombre producto" />
      <TextField fx:id="agregarNombreTxtField" layoutX="694.0" layoutY="113.0" prefHeight="25.0" prefWidth="165.0" />
      <Label fx:id="codigoAgregarLable" layoutX="579.0" layoutY="158.0" text="Codigo producto" />
      <TextField fx:id="agregarCodigoTxtfield" layoutX="698.0" layoutY="154.0" prefHeight="25.0" prefWidth="157.0" />
      <Label fx:id="agregarDisponiblesLabel" layoutX="580.0" layoutY="200.0" prefHeight="17.0" prefWidth="117.0" text="Unidades disponibles" />
      <Label fx:id="agregarVendidasLabel" layoutX="580.0" layoutY="242.0" text="Unidades vendidas" />
      <ComboBox fx:id="categoriasComboBox" layoutX="702.0" layoutY="288.0" prefHeight="25.0" prefWidth="149.0" />
      <Label fx:id="categoriasLabel" layoutX="578.0" layoutY="287.0" text="Categoria" />
      <ComboBox fx:id="proveedoresComboBox" layoutX="702.0" layoutY="338.0" prefHeight="25.0" prefWidth="149.0" />
      <Label fx:id="proveedoresLabel" layoutX="579.0" layoutY="342.0" text="Proveedores" />
      <Button fx:id="agregaProveedorInventarioButton" layoutX="667.0" layoutY="384.0" mnemonicParsing="false" onAction="#agregarProveedorProductoOnAction" text="Agregar Proveedor" />
      <Spinner fx:id="unidadesDisponiblesSpinner" layoutX="701.0" layoutY="196.0" />
      <Spinner fx:id="unidadesVendidasSpinner" layoutX="701.0" layoutY="238.0" />
   </children>
</AnchorPane>
