<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="553.0" prefWidth="994.0" styleClass="anchor-pane" stylesheets="@estilos/ventanaAdministrador.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.alquiler.controller.VentanaAdministradorController">

    <children>

        <!-- Tabla Inventario -->
        <TableView fx:id="inventarioTable" layoutX="14.0" layoutY="173.0" prefHeight="200.0" prefWidth="632.0" styleClass="table-view">
            <columns>
                <TableColumn fx:id="nombreInventarioColumn" prefWidth="96.0" text="Nombre" />
                <TableColumn fx:id="codigoInventarioPColum" prefWidth="116.0" text="Código" />
                <TableColumn fx:id="disponiblesColum" prefWidth="82.0" text="Disponibles" />
                <TableColumn fx:id="vendidasColumn" prefWidth="73.0" text="Vendidas" />
                <TableColumn fx:id="numeroReferenciaColumn" prefWidth="138.0" text="Número Referencia" />
            <TableColumn fx:id="disponibleProductoColumn" prefWidth="121.0" text="Descatalogado" />
            </columns>
        </TableView>

        <!-- Formulario Agregar Producto -->
        <Label fx:id="nombreAgregarLabel" layoutX="649.0" layoutY="68.0" styleClass="label" text="Nombre producto" />
        <TextField fx:id="agregarNombreTxtField" layoutX="810.0" layoutY="61.0" prefHeight="25.0" prefWidth="165.0" styleClass="text-field" />

        <Label fx:id="codigoAgregarLable" layoutX="648.0" layoutY="103.0" styleClass="label" text="Código producto" />
        <TextField fx:id="agregarCodigoTxtfield" layoutX="810.0" layoutY="96.0" prefHeight="25.0" prefWidth="165.0" styleClass="text-field" />

        <Label fx:id="agregarDisponiblesLabel" layoutX="649.0" layoutY="142.0" styleClass="label" text="Unidades disponibles" />
        <Spinner fx:id="unidadesDisponiblesSpinner" layoutX="810.0" layoutY="131.0" prefWidth="165.0" styleClass="spinner" />

        <Label fx:id="agregarVendidasLabel" layoutX="656.0" layoutY="187.0" styleClass="label" text="Unidades vendidas" />
        <Spinner fx:id="unidadesVendidasSpinner" layoutX="810.0" layoutY="176.0" prefWidth="165.0" styleClass="spinner" />

        <Label fx:id="categoriasLabel" layoutX="654.0" layoutY="226.0" styleClass="label" text="Categoría" />
        <ComboBox fx:id="categoriasComboBox" layoutX="805.0" layoutY="221.0" prefHeight="25.0" prefWidth="165.0" styleClass="combo-box" />

        <Label fx:id="proveedoresLabel" layoutX="655.0" layoutY="268.0" styleClass="label" text="Proveedores" />
        <ComboBox fx:id="proveedoresComboBox" layoutX="805.0" layoutY="259.0" prefHeight="25.0" prefWidth="165.0" styleClass="combo-box" />

        <Label fx:id="proveedoresAgregadosLabel" layoutX="654.0" layoutY="300.0" styleClass="label" text="Proveedores agregados" />
        <ComboBox fx:id="proveedoresAgregadosComboBox" layoutX="805.0" layoutY="294.0" prefHeight="25.0" prefWidth="165.0" styleClass="combo-box" />

        <!-- Botones de acción -->
        <Button fx:id="agregarProductoButton" layoutX="651.0" layoutY="381.0" onAction="#agregarProductoOnAction" prefHeight="35.0" prefWidth="152.0" styleClass="button" text="Agregar producto" />

        <Button fx:id="modificarProductoButton" layoutX="812.0" layoutY="381.0" onAction="#modificarProductoOnAction" prefHeight="35.0" prefWidth="152.0" styleClass="button" text="Modificar producto" />

        <Button fx:id="agregaProveedorInventarioButton" layoutX="651.0" layoutY="422.0" onAction="#agregarProveedorProductoOnAction" prefHeight="35.0" prefWidth="152.0" styleClass="button" text="Agregar proveedor" />

        <Button fx:id="quitarProveedorProductoButton" layoutX="811.0" layoutY="422.0" onAction="#quitarProveedor" prefHeight="35.0" prefWidth="152.0" styleClass="button" text="Quitar proveedor" />

        <Button fx:id="descatalogarButton" layoutX="649.0" layoutY="471.0" onAction="#descatalogarOnAction" prefHeight="35.0" prefWidth="152.0" styleClass="button" text="Descatalogar" />

        <!-- Sección izquierda inferior -->
        <Button fx:id="InformacionGeneralButton" layoutX="14.0" layoutY="84.0" onAction="#InformacionGeneralOnAction" prefHeight="25.0" prefWidth="180.0" styleClass="button" text="Información general" />

        <Button fx:id="verificarModificacionesButton" layoutX="200.0" layoutY="84.0" onAction="#verificarModificacionesOnAction" prefHeight="25.0" prefWidth="180.0" styleClass="button" text="Verificar modificaciones" />

        <Button fx:id="verificarPedidos" layoutX="386.0" layoutY="84.0" onAction="#verificarPedidosOnAction" prefHeight="25.0" prefWidth="180.0" styleClass="button" text="Verificar pedidos" />
      <AnchorPane layoutY="-5.0" prefHeight="63.0" prefWidth="994.0" style="-fx-background-color: #5EB0E8;">
         <children>
      
              <!-- Título -->
              <Label fx:id="opcionesAdminLbl" layoutX="26.0" layoutY="20.0" styleClass="titulo-label" text="Opciones administrador" />
         </children>
      </AnchorPane>
      <AnchorPane layoutY="514.0" prefHeight="39.0" prefWidth="994.0" style="-fx-background-color: #5EB0E8;" />
      <Label fx:id="valorPorductoLabel" layoutX="654.0" layoutY="340.0" text="Valor producto" />
      <Spinner fx:id="valorProductoSpinner" layoutX="799.0" layoutY="329.0" />
      <Button fx:id="deseleccionarButton" layoutX="14.0" layoutY="381.0" mnemonicParsing="false" onAction="#deseccionarOnAction" text="Deseleccionar" />
      <Button fx:id="catalogarButton" layoutX="812.0" layoutY="471.0" mnemonicParsing="false" onAction="#catalogarProductoOnAction" prefHeight="35.0" prefWidth="152.0" text="Catalogar" />

    </children>
</AnchorPane>
