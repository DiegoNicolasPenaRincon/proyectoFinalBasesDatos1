<jasperReport name="ReporteDetallePedido" language="java" columnCount="1" pageWidth="595" pageHeight="842" whenNoDataType="NoPages" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d2e8b59f-0a9f-432f-8ea5-58d402cb102f">
	<parameter name="codigoPedido" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT p.categoria AS nombreCategorias, p.nombre AS NombreProducto, p.codigo AS codigoProducto,
                   p.undidadesDisponibles AS unidadesDisponiblesProduto, p.valor AS valorProducto,
                   pp.codigoPedido AS codigoPedido, pp.cantidadAdquirida
            FROM Producto p
            JOIN Pedido_Producto pp ON p.codigo = pp.codigoProducto
            WHERE pp.codigoPedido = $P{codigoPedido};]]></query>
	<field name="nombreCategorias" class="java.lang.String"/>
	<field name="NombreProducto" class="java.lang.String"/>
	<field name="codigoProducto" class="java.lang.Integer"/>
	<field name="unidadesDisponiblesProduto" class="java.lang.Integer"/>
	<field name="valorProducto" class="java.lang.Double"/>
	<field name="codigoPedido" class="java.lang.Integer"/>
	<field name="cantidadAdquirida" class="java.lang.Integer"/>
