<jasperReport name="ReporteProductoPedidoPorCodigo" language="java" columnCount="1" pageWidth="595" pageHeight="842" whenNoDataType="NoPages" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c1d4e570-2891-4ef7-a39a-89a219b903fa">
	<parameter name="codigoPedido" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT *, pp.codigoPedido, pp.cantidadAdquirida 
            FROM Producto p 
            JOIN Pedido_Producto pp ON p.codigo = pp.codigoProducto
            WHERE pp.codigoPedido = $P{codigoPedido};]]></query>
