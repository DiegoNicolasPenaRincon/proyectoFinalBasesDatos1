<jasperReport name="ReporteProductos" language="java" columnCount="1" pageWidth="595" pageHeight="842" whenNoDataType="NoPages" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="123e4567-e89b-12d3-a456-426614174000">
	<query language="sql"><![CDATA[SELECT 
            p.codigo AS codigoProducto,
            p.nombre AS nombreProducto,
            p.categoria AS Categoria,
            p.valor AS ValorProducto,
            (c.utilidad * p.valor) AS valorUtilidad,
            (c.iva * p.valor) AS ValorIva,
            (p.valor + (c.utilidad * p.valor) + (c.iva * p.valor)) AS valorProducto
        FROM Producto p
        JOIN CategoriaProducto c ON p.categoria = c.nombre]]></query>
	<field name="codigoProducto" class="java.lang.String"/>
	<field name="nombreProducto" class="java.lang.String"/>
	<field name="Categoria" class="java.lang.String"/>
	<field name="ValorProducto" class="java.lang.Double"/>
	<field name="valorUtilidad" class="java.lang.Double"/>
	<field name="ValorIva" class="java.lang.Double"/>
	<field name="valorProducto" class="java.lang.Double"/>
